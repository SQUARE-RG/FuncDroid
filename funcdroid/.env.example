# Single OpenAI-compatible endpoint shared by every model role
# (planning, scenario execution, FFG update, and bug detection).
API_KEY=
BASE_URL=
MODEL=

# Async background defect-detection settings
# Optional: seconds to wait for the background defect-detection queue to drain
# before writing final outputs (0 or unset waits indefinitely).
# BUG_DETECTION_FLUSH_TIMEOUT_SECONDS=180
# Maximum number of screenshot-heavy reviews retained in memory. When full,
# execution waits for a slot by default so completed traces are not discarded.
BUG_DETECTION_MAX_PENDING=8
# 0 waits indefinitely; positive values bound the wait; negative restores
# non-blocking/drop behavior explicitly.
BUG_DETECTION_SUBMIT_WAIT_SECONDS=0

# Optional runtime settings
LLM_REQUEST_TIMEOUT=120
LLM_RETRY_ATTEMPTS=3
LLM_USAGE_SAVE_EVERY_N=20
LLM_USAGE_SAVE_MIN_INTERVAL=5.0
LLM_USAGE_SAVE_ERROR_LOG_INTERVAL=60
CHECKPOINT_FAILURE_LOG_INTERVAL_SECONDS=60
# 0 means no workflow-iteration cap; TOTAL_TIME remains the primary stop condition.
MAX_ITERATIONS=0
TOTAL_TIME=90
LONG_RUN_IDLE_SECONDS=120
# 场景执行（test 阶段）单轮步数上限
MAX_EXEC_STEPS=15
# 导航阶段单轮步数上限（与 MAX_EXEC_STEPS 相互独立）
MAX_NAVIGATION_STEPS=10
EXEC_ACTION_FAILURE_RECOVERIES=1
# 单轮场景内允许的模型错误（含超时）总数；只限累计次数，不改连续失败判定。
EXEC_MAX_TOTAL_LLM_ERRORS=4
# 方向/动作无关的兜底停滞判据：连续多少步停留在同一 Activity 且视觉状态数不超过
# 阈值时判定盲试并提前收尾。用于拦下 scroll 上/左/右与 click 交替的来回试探。
EXEC_NO_PROGRESS_STALL_WINDOW=6
EXEC_NO_PROGRESS_MAX_VISUAL_STATES=2
# 聚类“同一视觉状态”的相似度阈值；比重复动作判定更宽松，判断的是界面有无实质变化。
EXEC_NO_PROGRESS_SIMILARITY=0.985
# 连续执行失败多少次后把功能标记为 blocked（终端，不再重试、不进覆盖审计）。
FUNCTION_FAILURE_BLOCK_THRESHOLD=3
# 跨功能组合连续失败多少次后停止重复尝试。
CROSS_FAILURE_BLOCK_THRESHOLD=1
# 把“执行成功但既无新页面也无新功能”计入功能无进展次数，达到
# FUNCTION_FAILURE_BLOCK_THRESHOLD 后让出调度，避免困在 WebView 长文这类无底洞页面。
FFG_ZERO_YIELD_COUNTS_AS_NO_PROGRESS=1
# 覆盖率达到该百分比后才把零产出计入无进展；探索初期需要几轮铺垫。
FFG_ZERO_YIELD_MIN_COVERAGE=50
# 单功能功能内场景硬预算；达到后强制收尾，剩余入口交给覆盖审计按截图复核。
PLAN_MAX_SCENARIOS_PER_FUNCTION=6
# 单个补测场景一次覆盖的控件族数量；调大可摊薄每轮固定开销，但会拉长单个场景。
PLAN_SCENARIO_CONTROL_BATCH=4
# 程序派生的控件族覆盖率达到该百分比后进入完成与遗漏审计。
PLAN_FUNCTION_COVERAGE_TARGET=80
EXEC_TEST_SCROLL_INTENT_REPEAT_WINDOW=3
EXEC_NAV_SCROLL_INTENT_REPEAT_WINDOW=2
EXEC_WAIT_STALL_REPEAT_WINDOW=2
LANGGRAPH_RECURSION_LIMIT=1000000
APP_RECOVERY_BACK_ATTEMPTS=3
APP_RESTART_ATTEMPTS=2
APP_RESTART_RETRY_DELAY=1.0
FOREGROUND_CHECK_RETRIES=2
MAX_CONSECUTIVE_TARGET_APP_UNAVAILABLE=3
# These opt-in switches restore fail-fast behavior; long-running mode retries by default.
STOP_AFTER_CONSECUTIVE_NODE_ERRORS=0
STOP_AFTER_SCREENSHOT_UNAVAILABLE=0
STOP_AFTER_TARGET_APP_UNAVAILABLE=0
# Hard timeout for individual connector adb commands (seconds)
ADB_COMMAND_TIMEOUT=30
# Batch-only adb timeouts and per-App subprocess watchdog (seconds).
# BATCH_PROCESS_TIMEOUT is the fallback when --total-time is 0.
BATCH_ADB_COMMAND_TIMEOUT=30
BATCH_ADB_INSTALL_TIMEOUT=300
BATCH_PROCESS_TIMEOUT=7200
BATCH_PROCESS_TIMEOUT_GRACE=300
BATCH_PROCESS_TERMINATE_GRACE=15
FFG_UPDATE_IMAGE_MAX_SIDE=768
FFG_UPDATE_IMAGE_QUALITY=72
# Full unmatched traces are never image-truncated; allow local multimodal models
# enough time to inspect every observation. Total workflow time still bounds retries.
FFG_UPDATE_LLM_TIMEOUT=300
# test 阶段截图与已存页面 Activity 一致且视觉高度匹配时，
# 用该页面文本摘要替代截图上传，显著降低多模态 token。
FFG_UPDATE_MATCHED_IMAGE_THRESHOLD=0.98
# 无变化快速路径会直接跳过 FFG 模型，因此使用更严格的独立阈值。
FFG_UPDATE_FAST_PATH_IMAGE_THRESHOLD=0.995
# Disabled by default for evidence fidelity. Enable only when the selected model
# context is too small and the visual-similarity tradeoff is explicitly accepted.
FFG_UPDATE_OMIT_MATCHED_TRACE_IMAGES=0
FFG_UPDATE_FAST_PATH_ENABLED=0
FFG_UPDATE_MAX_STEPS=4
FFG_UPDATE_MAX_REFERENCE_IMAGES=12
# Soft cap for one FFG request. Unmatched trace screenshots may exceed it so
# newly observed Pages are never hidden by the budget.
FFG_UPDATE_MAX_TOTAL_IMAGES=6
# Refinement resends validation-related steps and neighbors. This value limits
# only additional stored-Page references; issue-related trace evidence is never dropped.
FFG_UPDATE_MAX_REFINEMENT_IMAGES=3
FFG_UPDATE_CANDIDATES_PER_OBSERVATION=3
FFG_UPDATE_MAX_BOUNDARY_PAGES=24
FFG_UPDATE_MAX_FOCUSED_FUNCTIONS=12
FFG_UPDATE_MAX_FOCUSED_PAGES=24
FFG_UPDATE_MAX_GLOBAL_FUNCTIONS=160
FFG_UPDATE_SUMMARY_MAX_CHARS=32000
FFG_CONTEXT_FIELD_MAX_CHARS=500
# Keep the representative screenshot plus at most 11 useful state variants per Page.
FFG_MAX_SCREENSHOTS_PER_PAGE=12
PLAN_MAX_FOCUSED_FUNCTIONS=12
PLAN_MAX_FOCUSED_PAGES=30
PLAN_MAX_GLOBAL_FUNCTIONS=160
PLAN_MAX_CROSS_TEST_PAIRS=20
PLAN_MAX_COMPLETION_AUDITS_PER_FUNCTION=20
PLAN_SUMMARY_MAX_CHARS=40000
PLAN_SUMMARY_FIELD_MAX_CHARS=600
LOGCAT_CAPTURE=1
# Rotate run.log during long runs; 0 disables rotation.
RUN_LOG_ROTATE_BYTES=67108864
RUN_LOG_BACKUP_COUNT=3
# Rotate full logcat to protect long runs from disk exhaustion; 0 disables rotation.
LOGCAT_ROTATE_BYTES=268435456
LOGCAT_BACKUP_COUNT=3
# Add a timeline point even when no new Activity appears (seconds).
ACTIVITY_TIMELINE_HEARTBEAT_SECONDS=300
OUTPUT_ROOT=output
